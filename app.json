{
  "expo": {
    "name": "CineMatch",
    "slug": "CineMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/claquete.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1025",
        "foregroundImage": "./assets/claquete.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/claquete.png"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}